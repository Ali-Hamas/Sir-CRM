  id              String    @id @default(uuid()) @map("_id")
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workspaceId     String?
  workspace       Workspace? @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  channel         String    // EMAIL, SLACK, TEAMS, DISCORD, SMS, PUSH, WEBHOOK
  subject         String?
  body            String
  bodyFormat      String    @default("HTML")
  senderId        String?   // user who sent
  sender          User?     @relation(fields: [senderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recipients      String    // JSON array of {address, name, type}
  cc              String?   // JSON array
  bcc             String?   // JSON array
  attachments     String?   // JSON array

  status          String    @default("PENDING") // PENDING, SENDING, DELIVERED, FAILED, BOUNCED, READ
  priority        String    @default("NORMAL")
  scheduledAt     DateTime?
  sentAt          DateTime?
  deliveredAt     DateTime?
  readAt          DateTime?
  errorMessage    String?

  externalId      String?   // provider message ID
  providerId      String?
  provider        CommunicationProvider? @relation(fields: [providerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  templateId      String?
  template        CommunicationTemplate? @relation(fields: [templateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  relatedEntityType String?
  relatedEntityId String?
  retryCount      Int       @default(0)
  maxRetries      Int       @default(3)
  batchId         String?   // for bulk messaging grouping

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  deliveries      CommunicationDelivery[]
  audits          CommunicationAudit[]

  @@index([organizationId, status])
  @@index([organizationId, channel])
  @@index([organizationId, createdAt])
  @@index([batchId])
  @@index([relatedEntityType, relatedEntityId])
}

