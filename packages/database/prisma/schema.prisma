  docUrl                String?
  isVerified            Boolean                 @default(true)
  isEnabled             Boolean                 @default(true)
  supportedCapabilities String                  @default("[]") // JSON string array
  configSchemaJson      String                  @default("{}") // JSON schema for settings

  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  connections           IntegrationConnection[]
  templates             IntegrationTemplate[]

  @@index([category])
}

model IntegrationConnection {
  id                   String                  @id @default(uuid()) @map("_id")
  organizationId       String
  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workspaceId          String?
  workspace            Workspace?              @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  providerId           String
  provider             IntegrationProvider     @relation(fields: [providerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  name                 String
  status               String                  @default("CONNECTED") // CONNECTED, DISCONNECTED, ERROR, SYNCING, EXPIRED
  authType             String                  @default("OAUTH2")
  externalAccountId    String?
  externalAccountEmail String?
  scopes               String                  @default("[]") // JSON array of granted scopes
  settingsJson         String                  @default("{}") // Custom config settings JSON
  healthStatus         String                  @default("HEALTHY") // HEALTHY, DEGRADED, UNHEALTHY

  lastSyncedAt         DateTime?
  lastError            String?
  createdById          String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  credentials          IntegrationCredential[]
  syncJobs             IntegrationSyncJob[]
  logs                 IntegrationLog[]
  webhooks             IntegrationWebhook[]
  events               IntegrationEvent[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([providerId])
}

model IntegrationCredential {
  id            String                @id @default(uuid()) @map("_id")
  connectionId  String
  connection    IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  type          String                // ACCESS_TOKEN, REFRESH_TOKEN, API_KEY, SECRET_KEY, WEBHOOK_SECRET
  encryptedData String                // AES-256 encrypted payload
  iv            String                // AES Initialization Vector
  expiresAt     DateTime?
  isRevoked     Boolean               @default(false)

  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([connectionId])
  @@index([connectionId, type])
}

model IntegrationSyncJob {
  id               String                @id @default(uuid()) @map("_id")
  organizationId   String
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  connectionId     String
  connection       IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  syncType         String                @default("INCREMENTAL") // FULL, INCREMENTAL, MANUAL, SCHEDULED
  status           String                @default("PENDING")     // PENDING, IN_PROGRESS, COMPLETED, FAILED
  entityType       String                // CONTACTS, ISSUES, MESSAGES, INVOICES, DOCUMENTS, CALENDAR_EVENTS
  recordsProcessed Int                   @default(0)
  recordsFailed    Int                   @default(0)
  errorMessage     String?

  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  logs             IntegrationLog[]

  @@index([organizationId])
  @@index([connectionId])
  @@index([status])
}

model IntegrationLog {
  id             String                 @id @default(uuid()) @map("_id")
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  connectionId   String?
  connection     IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  syncJobId      String?
  syncJob        IntegrationSyncJob?    @relation(fields: [syncJobId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  level          String                 @default("INFO") // INFO, WARN, ERROR, DEBUG
  action         String                 // OAUTH_CONNECT, TOKEN_REFRESH, SYNC_START, SYNC_COMPLETE, WEBHOOK_RECEIVED, API_ERROR
  message        String
  metadataJson   String                 @default("{}")

  createdAt      DateTime               @default(now())

  @@index([organizationId])
  @@index([connectionId])
  @@index([level])
}

model IntegrationWebhook {
  id              String                 @id @default(uuid()) @map("_id")
  organizationId  String
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  connectionId    String?
  connection      IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  name            String
  webhookUrl      String
  secretKey       String?
  events          String                 // JSON string array of subscribed events
  isEnabled       Boolean                @default(true)

  lastTriggeredAt DateTime?
  totalDelivered  Int                    @default(0)
  totalFailed     Int                    @default(0)

  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  eventsList      IntegrationEvent[]

  @@index([organizationId])
  @@index([connectionId])
}

model IntegrationEvent {
  id             String                 @id @default(uuid()) @map("_id")
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  connectionId   String?
  connection     IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  webhookId      String?
  webhook        IntegrationWebhook?    @relation(fields: [webhookId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  eventType      String                 // github.push, stripe.payment_intent.succeeded, slack.message, etc.
  payloadJson    String
  status         String                 @default("PROCESSED") // RECEIVED, PROCESSED, FAILED, RETRYING

  processedAt    DateTime?
  errorMessage   String?
  createdAt      DateTime               @default(now())

  @@index([organizationId])
  @@index([connectionId])
  @@index([eventType])
}

model IntegrationTemplate {
  id                 String               @id @default(uuid()) @map("_id")
  organizationId     String?
  organization       Organization?        @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  providerId         String?
  provider           IntegrationProvider? @relation(fields: [providerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  name               String
  description        String?
  category           String
  configTemplateJson String               @default("{}")
  isPublic           Boolean              @default(true)

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([category])
}






