generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid()) @map("_id")
  email             String    @unique
  passwordHash      String
  firstName         String?
  lastName          String?
  phone             String?
  profilePictureUrl String?
  role              String    @default("CLIENT")
  isEmailVerified   Boolean   @default(false)
  isActive          Boolean   @default(true)
  lastLogin         DateTime?
  dateJoined        DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  refreshTokens     RefreshToken[]
  verificationTokens VerificationToken[]
  
  organizationMembers OrganizationMember[]
  workspaceMembers    WorkspaceMember[]
  teamMembers         TeamMember[]
  userActivities      UserActivity[]
  notifications       Notification[]
  notificationPrefs   NotificationPreference[]
  departmentHeads     Department[] @relation("DepartmentHead")
  teamLeaders         Team[]       @relation("TeamLeader")
  companyAssigned     Company[]    @relation("CompanyAssignedTo")
  companyCreated      Company[]    @relation("CompanyCreatedBy")
  companyNotesCreated CompanyNote[] @relation("CompanyNoteCreatedBy")
  companyActivities   CompanyActivity[]
  contactAssigned     Contact[]    @relation("ContactAssignedTo")
  contactCreated      Contact[]    @relation("ContactCreatedBy")
  contactNotesCreated ContactNote[] @relation("ContactNoteCreatedBy")
  contactActivities   ContactActivity[]
  leadAssigned        Lead[]        @relation("LeadAssignedTo")
  leadCreated         Lead[]        @relation("LeadCreatedBy")
  leadNotesCreated    LeadNote[]    @relation("LeadNoteCreatedBy")
  leadActivities      LeadActivity[]
  opportunityAssigned Opportunity[]  @relation("OpportunityAssignedTo")
  opportunityCreated  Opportunity[]  @relation("OpportunityCreatedBy")
  opportunityNotesCreated OpportunityNote[] @relation("OpportunityNoteCreatedBy")
  opportunityActivities  OpportunityActivity[]
  meetingCreated         Meeting[]        @relation("MeetingCreatedBy")
  meetingNotesCreated    MeetingNote[]    @relation("MeetingNoteCreatedBy")
  meetingActionItems     MeetingActionItem[] @relation("MeetingActionItemOwner")
  meetingParticipations  MeetingParticipant[]
  proposalCreated        Proposal[]       @relation("ProposalCreatedBy")
  proposalOwner          Proposal[]       @relation("ProposalOwner")
  proposalApprovals      ProposalApprovalLog[] @relation("ProposalApprovals")
  proposalActivities     ProposalActivity[] @relation("ProposalActivities")
  contractCreated        Contract[]       @relation("ContractCreatedBy")
  contractOwner          Contract[]       @relation("ContractOwner")
  contractApprovalLogs   ContractApproval[] @relation("ContractApprovalLogs")
  contractActivities     ContractActivity[]
  folders             Folder[]
  documents           Document[]
  documentComments    DocumentComment[]
  favoriteDocuments   FavoriteDocument[]
  projectManaged      Project[]        @relation("ProjectManager")
  projectCreated      Project[]        @relation("ProjectCreatedBy")
  projectActivities   ProjectActivity[]
  projectMembers      ProjectMember[]
  taskReported        Task[]           @relation("TaskReporter")
  taskCreated         Task[]           @relation("TaskCreatedBy")
  taskComments        TaskComment[]
  taskAttachments     TaskAttachment[]
  taskAssignments     TaskAssignee[]
  timeEntries         TimeEntry[]          @relation("TimeEntryUser")
  timeEntriesCreated  TimeEntry[]          @relation("TimeEntryCreator")
  resourceAllocations ResourceAllocation[] @relation("ResourceAllocationUser")
  resourceAllocationsCreated ResourceAllocation[] @relation("ResourceAllocationCreator")
  workSchedules       WorkSchedule[]
  knowledgeArticles   KnowledgeArticle[]
  knowledgeRevisions  KnowledgeRevision[]
  knowledgeComments   KnowledgeComment[]
  knowledgeFavorites  KnowledgeFavorite[]
  knowledgeAttachments KnowledgeAttachment[]
  recentSearches      RecentSearch[]
  workflowsCreated    Workflow[]          @relation("WorkflowCreatedBy")
  workflowsUpdated    Workflow[]          @relation("WorkflowUpdatedBy")
  workflowExecutions  WorkflowExecution[]
  aiProvidersCreated  AIProvider[]        @relation("AIProviderCreatedBy")
  aiProvidersUpdated  AIProvider[]        @relation("AIProviderUpdatedBy")
  promptsCreated      PromptTemplate[]    @relation("PromptCreatedBy")
  promptsUpdated      PromptTemplate[]    @relation("PromptUpdatedBy")
  promptVersionsCreated PromptVersion[]   @relation("PromptVersionCreatedBy")
  promptExecutionLogs PromptExecutionLog[]
  aiConversations     AIConversation[]
  aiConversationFolders AIConversationFolder[]
  aiConversationShares AIConversationShare[]
  aiConversationPins  AIConversationPin[]
  aiMemories          AIMemory[]
  aiUserPreferences   AIUserPreference[]
  aiAssistantsCreated   AIAssistant[]          @relation("AIAssistantCreatedBy")
  aiAssistantsUpdated   AIAssistant[]          @relation("AIAssistantUpdatedBy")
  aiAssistantSessions   AIAssistantSession[]
  aiAssistantExecutions AIAssistantExecution[]
  aiToolExecutions      AIToolExecution[]
  ragSearches           RAGSearch[]
  aiAgentsCreated       AIAgent[]              @relation("AIAgentCreatedBy")
  aiAgentsUpdated       AIAgent[]              @relation("AIAgentUpdatedBy")
  aiAgentExecutions     AIAgentExecution[]
  agentWorkflows        AgentWorkflow[]
  businessProcessApprovalsAssigned BusinessProcessApproval[] @relation("BusinessProcessApprovalAssigned")
  businessProcessApprovalsDecided  BusinessProcessApproval[] @relation("BusinessProcessApprovalDecidedBy")
  businessProcessAudits            BusinessProcessAudit[]
  communicationProviders           CommunicationProvider[]   @relation("CommunicationProviderCreatedBy")
  communicationTemplatesCreated    CommunicationTemplate[]   @relation("CommunicationTemplateCreatedBy")
  communicationMessages            CommunicationMessage[]
  communicationWebhooksCreated     CommunicationWebhook[]    @relation("CommunicationWebhookCreatedBy")
  communicationSubscriptions       CommunicationSubscription[]
}

model RefreshToken {
  id        String   @id @default(uuid()) @map("_id")
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
}

model VerificationToken {
  id        String   @id @default(uuid()) @map("_id")
  token     String   @unique
  type      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Organization {
  id            String   @id @default(uuid()) @map("_id")
  name          String
  legalName     String?
  industry      String?
  businessType  String?
  companySize   String?
  country       String?
  stateRegion   String?
  city          String?
  address       String?
  postalCode    String?
  timezone      String?
  currency      String?
  logoUrl       String?
  slug          String   @unique
  status        String   @default("ACTIVE")

  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspaces    Workspace[]
  members       OrganizationMember[]
  departments   Department[]
  teams         Team[]
  invitations   Invitation[]
  activities    UserActivity[]
  customRoles   CustomRole[]
  notifications Notification[]
  folders       Folder[]
  documents     Document[]
  companies     Company[]
  contacts      Contact[]
  leads         Lead[]
  opportunities Opportunity[]
  meetings      Meeting[]
  proposals     Proposal[]
  contracts     Contract[]
  clients       Client[]
  projects      Project[]
  tasks         Task[]
  timeEntries   TimeEntry[]
  resourceAllocations ResourceAllocation[]
  workSchedules WorkSchedule[]
  knowledgeArticles   KnowledgeArticle[]
  knowledgeCategories KnowledgeCategory[]
  recentSearches      RecentSearch[]
  workflows           Workflow[]
  workflowExecutions  WorkflowExecution[]
  aiProviders         AIProvider[]
  promptCategories    PromptCategory[]
  promptTemplates     PromptTemplate[]
  promptExecutionLogs PromptExecutionLog[]
  aiConversations     AIConversation[]
  aiConversationFolders AIConversationFolder[]
  aiMemoryCategories  AIMemoryCategory[]
  aiMemories          AIMemory[]
  aiContexts          AIContext[]
  aiWorkspaceMemories AIWorkspaceMemory[]
  aiUserPreferences   AIUserPreference[]
  aiAssistants          AIAssistant[]
  aiAssistantSessions   AIAssistantSession[]
  aiAssistantExecutions AIAssistantExecution[]
  aiToolExecutions      AIToolExecution[]
  ragIndexes            RAGIndex[]
  ragDocuments          RAGDocument[]
  ragSearches           RAGSearch[]
  aiAgents              AIAgent[]
  aiAgentExecutions     AIAgentExecution[]
  executiveDashboards   ExecutiveDashboard[]
  executiveInsights     ExecutiveInsight[]
  executiveMetrics      ExecutiveMetric[]
  executiveAlerts       ExecutiveAlert[]
  executivePredictions  ExecutivePrediction[]
  agentWorkflows        AgentWorkflow[]
  businessProcesses     BusinessProcess[]
  businessProcessTemplates     BusinessProcessTemplate[]
  businessProcessExecutions    BusinessProcessExecution[]
  businessProcessApprovals     BusinessProcessApproval[]
  businessProcessAudits        BusinessProcessAudit[]
  businessProcessSchedules     BusinessProcessSchedule[]
  communicationProviders       CommunicationProvider[]
  communicationTemplates       CommunicationTemplate[]
  communicationMessages        CommunicationMessage[]
  communicationWebhooks        CommunicationWebhook[]
  communicationSubscriptions   CommunicationSubscription[]
  analyticsDashboards          AnalyticsDashboard[]
  analyticsMetrics             AnalyticsMetric[]
  analyticsSnapshots           AnalyticsSnapshot[]
  analyticsReports             AnalyticsReport[]
  analyticsForecasts           AnalyticsForecast[]
  analyticsAnomalies           AnalyticsAnomaly[]
  analyticsRecommendations     AnalyticsRecommendation[]
  analyticsDatasets            AnalyticsDataset[]
  integrationConnections       IntegrationConnection[]
  integrationSyncJobs          IntegrationSyncJob[]
  integrationLogs              IntegrationLog[]
  integrationWebhooks          IntegrationWebhook[]
  integrationEvents            IntegrationEvent[]
  integrationTemplates         IntegrationTemplate[]
}

model Workspace {
  id             String    @id @default(uuid()) @map("_id")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name           String
  description    String?
  logoUrl        String?
  color          String?
  status         String    @default("ACTIVE")

  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  members        WorkspaceMember[]
  invitations    Invitation[]
  folders        Folder[]
  documents      Document[]
  companies      Company[]
  contacts       Contact[]
  leads          Lead[]
  opportunities  Opportunity[]
  meetings       Meeting[]
  proposals      Proposal[]
  contracts      Contract[]
  projects       Project[]
  aiMemories     AIMemory[]
  aiToolExecutions AIToolExecution[]
  aiWorkspaceMemories AIWorkspaceMemory[]
  agentWorkflows        AgentWorkflow[]
  businessProcesses     BusinessProcess[]
  businessProcessTemplates     BusinessProcessTemplate[]
  businessProcessExecutions    BusinessProcessExecution[]
  businessProcessApprovals     BusinessProcessApproval[]
  businessProcessAudits        BusinessProcessAudit[]
  businessProcessSchedules     BusinessProcessSchedule[]
  communicationProviders       CommunicationProvider[]
  communicationTemplates       CommunicationTemplate[]
  communicationMessages        CommunicationMessage[]
  communicationWebhooks        CommunicationWebhook[]
  communicationSubscriptions   CommunicationSubscription[]
  analyticsDashboards          AnalyticsDashboard[]
  analyticsMetrics             AnalyticsMetric[]
  analyticsSnapshots           AnalyticsSnapshot[]
  analyticsReports             AnalyticsReport[]
  analyticsForecasts           AnalyticsForecast[]
  analyticsAnomalies           AnalyticsAnomaly[]
  analyticsRecommendations     AnalyticsRecommendation[]
  analyticsDatasets            AnalyticsDataset[]
  integrationConnections       IntegrationConnection[]
}

model BusinessProcess {
  id              String    @id @default(uuid()) @map("_id")
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workspaceId     String?
  workspace       Workspace? @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  name            String
  description     String?
  category        String?
  status          String      @default("DRAFT")
  priority        Int         @default(0)
  estimatedDuration Int?
  icon            String?
  color           String?
  tags            String?

  templateId      String?
  template        BusinessProcessTemplate? @relation(fields: [templateId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdBy       String?
  updatedBy       String?
  isDeleted       Boolean     @default(false)
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  executions      BusinessProcessExecution[]
  schedules       BusinessProcessSchedule[]
  audits          BusinessProcessAudit[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, isDeleted])
}

model BusinessProcessTemplate {
  id              String    @id @default(uuid()) @map("_id")
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workspaceId     String?
  workspace       Workspace? @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  name            String
  description     String?
  category        String?
  icon            String?
  color           String?
  tags            String?
  steps           String?
  config          String?

  isPreset        Boolean     @default(false)
  version         Int         @default(1)
  isDeleted       Boolean     @default(false)
  deletedAt       DateTime?
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  processes       BusinessProcess[]

  @@index([organizationId])
  @@index([organizationId, category])
}

model BusinessProcessExecution {
  id              String              @id @default(uuid()) @map("_id")
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workspaceId     String?
  workspace       Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  processId       String
  process         BusinessProcess     @relation(fields: [processId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  status          String              @default("PENDING")
  trigger         String?
  priority        Int                 @default(0)
  inputData       String?
  outputData      String?
  errorMessage    String?
  executionPlan   String?
  retryCount      Int                 @default(0)
  maxRetries      Int                 @default(3)
  retryDelayMs    Int                 @default(5000)

  startedAt       DateTime?
  completedAt     DateTime?
  createdBy       String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  steps           BusinessProcessStep[]
  approvals       BusinessProcessApproval[]
  audits          BusinessProcessAudit[]
  schedule        BusinessProcessSchedule?

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([processId])
  @@index([organizationId, createdAt])
}

model BusinessProcessStep {
  id              String                    @id @default(uuid()) @map("_id")
  executionId     String
  execution       BusinessProcessExecution  @relation(fields: [executionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  stepOrder       Int
  name            String
  type            String
  config          String?
  inputData       String?
  outputData      String?
  status          String                    @default("PENDING")
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  retryCount      Int                       @default(0)

  createdAt       DateTime                  @default(now())

  approvals       BusinessProcessApproval[]

  @@index([executionId])
  @@index([executionId, stepOrder])
}

model BusinessProcessApproval {
  id              String                    @id @default(uuid()) @map("_id")
  organizationId  String
  organization    Organization              @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workspaceId     String?
  workspace       Workspace?                @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  executionId     String
  execution       BusinessProcessExecution  @relation(fields: [executionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stepId          String?
  step            BusinessProcessStep?      @relation(fields: [stepId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  title           String
  description     String?
  assignedToId    String?
  assignedTo      User?                     @relation("BusinessProcessApprovalAssigned", fields: [assignedToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roleRequired    String?
  status          String                    @default("PENDING")
  comment         String?
  decidedById     String?
  decidedBy       User?                     @relation("BusinessProcessApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  decidedAt       DateTime?

  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([executionId])
  @@index([assignedToId])
  @@index([status])
}

model BusinessProcessAudit {
  id              String                    @id @default(uuid()) @map("_id")
  organizationId  String
  organization    Organization              @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workspaceId     String?
  workspace       Workspace?                @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  executionId     String?
  execution       BusinessProcessExecution? @relation(fields: [executionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  processId       String?
  process         BusinessProcess?          @relation(fields: [processId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  action          String
  entityType      String
  entityId        String
  userId          String?
  user            User?                     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  details         String?
  metadata        String?

  createdAt       DateTime                  @default(now())

  @@index([organizationId])
  @@index([executionId])
  @@index([processId])
  @@index([organizationId, createdAt])
}

model BusinessProcessSchedule {
  id              String                    @id @default(uuid()) @map("_id")
  organizationId  String
  organization    Organization              @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workspaceId     String?
  workspace       Workspace?                @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  processId       String
  process         BusinessProcess           @relation(fields: [processId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  executionId     String?                   @unique
  execution       BusinessProcessExecution? @relation(fields: [executionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  cronExpression  String?
  intervalMinutes Int?
  startAt         DateTime?
  endAt           DateTime?
  maxExecutions   Int                       @default(0)
  executedCount   Int                       @default(0)
  lastExecutedAt  DateTime?
  nextRunAt       DateTime?
  status          String                    @default("ACTIVE")
  config          String?

  isDeleted       Boolean                   @default(false)
  deletedAt       DateTime?
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([organizationId])
  @@index([processId])
  @@index([status, nextRunAt])
}

model Department {
  id             String    @id @default(uuid()) @map("_id")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name           String
  description    String?
  headId         String?
  head           User?     @relation("DepartmentHead", fields: [headId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  members        OrganizationMember[]
  teams          Team[]
}

model Team {
  id             String    @id @default(uuid()) @map("_id")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name           String
  description    String?
  color          String?
  avatarUrl      String?
  leaderId       String?
  leader         User?     @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  isDeleted      Boolean   @default(false)
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  members        TeamMember[]
}

model TeamMember {
  id             String    @id @default(uuid()) @map("_id")
  teamId         String
  team           Team      @relation(fields: [teamId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role           String    @default("MEMBER")

  createdBy      String?
  updatedBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, teamId])
}

model OrganizationMember {
  id             String    @id @default(uuid()) @map("_id")
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role           String
  customRoleId   String?
  customRole     CustomRole?  @relation(fields: [customRoleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  jobTitle       String?
  status         String    @default("ACTIVE")

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, organizationId])
}

model WorkspaceMember {
  id             String    @id @default(uuid()) @map("_id")
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role           String

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, workspaceId])
}

model Invitation {
  id             String    @id @default(uuid()) @map("_id")
  email          String
  token          String    @unique
  role           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workspaceId    String?
  workspace      Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status         String    @default("PENDING")

  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  createdBy      String?
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
}

model CustomRole {
  id             String    @id @default(uuid()) @map("_id")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name           String
  description    String?
  
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  permissions    RolePermission[]
  members        OrganizationMember[]
}

model RolePermission {
  id           String    @id @default(uuid()) @map("_id")
  customRoleId String
  customRole   CustomRole @relation(fields: [customRoleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resource     String
  action       String
  
  createdAt    DateTime  @default(now())

  @@unique([customRoleId, resource, action])
}

model UserActivity {
  id             String    @id @default(uuid()) @map("_id")
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  action         String
  module         String?
  entityType     String?
  entityId       String?
  metadata       String?
  ipAddress      String?
  device         String?

  createdAt      DateTime  @default(now())
  
  @@index([organizationId])
  @@index([userId])
}

model Notification {
  id             String    @id @default(uuid()) @map("_id")
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  title          String
  message        String
  category       String    @default("SYSTEM")
  priority       String    @default("LOW")
  linkUrl        String?
  isRead         Boolean   @default(false)
  
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, isRead])
  @@index([organizationId])
}

model NotificationPreference {
  id             String    @id @default(uuid()) @map("_id")
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  emailEnabled   Boolean   @default(true)
  pushEnabled    Boolean   @default(true)
  inAppEnabled   Boolean   @default(true)
  categories     String

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId])
}

model Folder {
  id             String    @id @default(uuid()) @map("_id")
  name           String
  
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workspaceId    String?
  workspace      Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  parentId       String?
  parent         Folder?   @relation("FolderToFolder", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children       Folder[]  @relation("FolderToFolder")

