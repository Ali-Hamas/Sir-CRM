  notes           String?

  companyId       String    @unique
  company         Company   @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdById     String
  activatedById   String?
  convertedAt     DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  projects        Project[]

  @@index([organizationId])
  @@index([status])
}

// ==========================================
// PROJECT MANAGEMENT
// ==========================================

model Project {
  id               String    @id @default(uuid()) @map("_id")
  projectName      String
  projectCode      String
  description      String?
  status           String    @default("PLANNING")
  priority         String    @default("MEDIUM")
  budget           Float?
  currency         String    @default("USD")
  startDate        DateTime?
  endDate          DateTime?
  progress         Int       @default(0)

  clientId         String?
  client           Client?   @relation(fields: [clientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  companyId        String?
  company          Company?  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contractId       String?
  contract         Contract? @relation(fields: [contractId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  projectManagerId String?
  projectManager   User?     @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workspaceId      String?
  workspace        Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdById      String
  createdBy        User      @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedBy        String?

  isDeleted        Boolean   @default(false)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  members          ProjectMember[]
  phases           ProjectPhase[]
  milestones       Milestone[]
  activities       ProjectActivity[]
  tasks            Task[]
  timeEntries      TimeEntry[]
  resourceAllocations ResourceAllocation[]

  @@index([organizationId])
  @@index([status])
  @@index([companyId])
}

model ProjectMember {
  id           String    @id @default(uuid()) @map("_id")
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role         String    @default("MEMBER")

  createdBy    String?
  updatedBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([projectId, userId])
}

model ProjectPhase {
  id           String    @id @default(uuid()) @map("_id")
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name         String
  description  String?
  status       String    @default("PENDING")
  sortOrder    Int       @default(0)
  startDate    DateTime?
  endDate      DateTime?
  completedAt  DateTime?

  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Milestone {
  id           String    @id @default(uuid()) @map("_id")
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  title        String
  description  String?
  status       String    @default("PENDING")
  priority     String    @default("MEDIUM")
  dueDate      DateTime?
  completedAt  DateTime?

  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tasks        Task[]

  @@index([projectId])
  @@index([status])
}

model ProjectActivity {
  id           String    @id @default(uuid()) @map("_id")
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  action       String
  description  String?
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  metadata     String?

  createdAt    DateTime  @default(now())
}

// ==========================================
// TASK MANAGEMENT & KANBAN
// ==========================================

model Task {
  id               String    @id @default(uuid()) @map("_id")
  title            String
  description      String?
  status           String    @default("TODO")
  priority         String    @default("MEDIUM")
  labels           String?
  tags             String?
  estimatedHours   Float?
  dueDate          DateTime?
  completedAt      DateTime?

  projectId        String
  project          Project   @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  milestoneId      String?
  milestone        Milestone? @relation(fields: [milestoneId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reporterId       String
  reporter         User      @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdById      String
  createdBy        User      @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedBy        String?

  isDeleted        Boolean   @default(false)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  assignees        TaskAssignee[]
  comments         TaskComment[]
  attachments      TaskAttachment[]
  checklists       TaskChecklist[]
  parentDependencies  TaskDependency[] @relation("TaskDependsOn")
  childDependencies   TaskDependency[] @relation("TaskBlocks")
  timeEntries      TimeEntry[]

  @@index([organizationId])
  @@index([projectId])
  @@index([status])
  @@index([priority])
  @@index([milestoneId])
}

model TaskAssignee {
  id           String    @id @default(uuid()) @map("_id")
  taskId       String
  task         Task      @relation(fields: [taskId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt    DateTime  @default(now())

  @@unique([taskId, userId])
}

model TaskComment {
  id           String    @id @default(uuid()) @map("_id")
  taskId       String
  task         Task      @relation(fields: [taskId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  content      String

  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model TaskAttachment {
  id           String    @id @default(uuid()) @map("_id")
  taskId       String
  task         Task      @relation(fields: [taskId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fileName     String
  originalName String
  mimeType     String
  size         Int
  storagePath  String

  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt    DateTime  @default(now())
}

model TaskChecklist {
  id           String    @id @default(uuid()) @map("_id")
  taskId       String
  task         Task      @relation(fields: [taskId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  title        String

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items        TaskChecklistItem[]
}

model TaskChecklistItem {
  id             String    @id @default(uuid()) @map("_id")
  checklistId    String
  checklist      TaskChecklist @relation(fields: [checklistId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  title          String
  isCompleted    Boolean   @default(false)
  sortOrder      Int       @default(0)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model TaskDependency {
  id               String    @id @default(uuid()) @map("_id")
  taskId           String
  task             Task      @relation("TaskBlocks", fields: [taskId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dependsOnId      String
  dependsOn        Task      @relation("TaskDependsOn", fields: [dependsOnId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  type             String    @default("FINISH_TO_START")

  createdAt        DateTime  @default(now())

  @@unique([taskId, dependsOnId])
}

// ==========================================
// RESOURCE MANAGEMENT & TIME TRACKING
// ==========================================

model TimeEntry {
  id             String    @id @default(uuid()) @map("_id")
  description    String?
  date           DateTime
  startTime      DateTime?
  endTime        DateTime?
  duration       Float?
  billable       Boolean   @default(false)
  status         String    @default("DRAFT")

  userId         String
  user           User      @relation("TimeEntryUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  projectId      String?
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  taskId         String?
  task           Task?     @relation(fields: [taskId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdById    String
  createdBy      User      @relation("TimeEntryCreator", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedBy      String?

  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@index([userId])
  @@index([projectId])
  @@index([taskId])
  @@index([date])
  @@index([status])
}

model ResourceAllocation {
  id                   String    @id @default(uuid()) @map("_id")
  role                 String?
  allocationPercentage Float     @default(100)
  startDate            DateTime
  endDate              DateTime?
  capacity             Float?
  notes                String?

  userId               String
  user                 User      @relation("ResourceAllocationUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  projectId            String
  project              Project   @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdById          String
  createdBy            User      @relation("ResourceAllocationCreator", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedBy            String?

  isDeleted            Boolean   @default(false)
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([userId, projectId])
  @@index([organizationId])
  @@index([userId])
  @@index([projectId])
}

model WorkSchedule {
  id             String    @id @default(uuid()) @map("_id")
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dayOfWeek      Int
  startTime      String
  endTime        String
  hoursPerDay    Float

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, organizationId, dayOfWeek])
  @@index([organizationId])
  @@index([userId])
}

model KnowledgeCategory {
  id             String    @id @default(uuid()) @map("_id")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name           String
  slug           String
  description    String?
  icon           String?
  color          String?

  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  articles       KnowledgeArticle[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model KnowledgeArticle {
  id               String    @id @default(uuid()) @map("_id")
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  title            String
  slug             String
  summary          String?
  content          String
  status           String    @default("DRAFT")
  visibility       String    @default("ORGANIZATION")
  featuredImageUrl String?

  authorId         String
  author           User      @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  categoryId       String?
  category         KnowledgeCategory? @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  isDeleted        Boolean   @default(false)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([authorId])
  @@index([categoryId])
  @@index([status])

  revisions        KnowledgeRevision[]
  comments         KnowledgeComment[]
  favorites        KnowledgeFavorite[]
  attachments      KnowledgeAttachment[]
}

model KnowledgeRevision {
  id            String           @id @default(uuid()) @map("_id")
  articleId     String
  article       KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  revisionNum   Int
  title         String
  content       String
  summary       String?
  changeSummary String?
  updatedById   String
  updatedBy     User             @relation(fields: [updatedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt     DateTime         @default(now())

  @@index([articleId])
  @@index([updatedById])
}

model KnowledgeComment {
  id        String           @id @default(uuid()) @map("_id")
  articleId String
  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  authorId  String
  author    User             @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  content   String
  isDeleted Boolean          @default(false)
  deletedAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([articleId])
  @@index([authorId])
}

model KnowledgeFavorite {
  id        String           @id @default(uuid()) @map("_id")
  articleId String
  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime         @default(now())

  @@unique([articleId, userId])
  @@index([articleId])
  @@index([userId])
}

model KnowledgeAttachment {
  id           String           @id @default(uuid()) @map("_id")
  articleId    String
  article      KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name         String
  originalName String
  mimeType     String
  size         Int
  storagePath  String
  uploadedById String
  uploadedBy   User             @relation(fields: [uploadedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isDeleted    Boolean          @default(false)
  deletedAt    DateTime?
  createdAt    DateTime         @default(now())

  @@index([articleId])
  @@index([uploadedById])
}

model RecentSearch {
  id             String       @id @default(uuid()) @map("_id")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  query          String
  createdAt      DateTime     @default(now())

  @@index([organizationId, userId])
}

model Workflow {
  id             String    @id @default(uuid()) @map("_id")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  name           String
  description    String?
  status         String    @default("DRAFT") // DRAFT, ACTIVE, DISABLED
  
  createdBy      String
  creator        User      @relation("WorkflowCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedBy      String?
  updater        User?     @relation("WorkflowUpdatedBy", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  triggers       WorkflowTrigger[]
  conditions     WorkflowCondition[]
  actions        WorkflowAction[]
  executions     WorkflowExecution[]

  @@index([organizationId, status])
  @@index([organizationId, isDeleted])
}

model WorkflowTrigger {
  id          String   @id @default(uuid()) @map("_id")
  workflowId  String
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  type        String   // LEAD_CREATED, LEAD_CONVERTED, OPPORTUNITY_WON, MEETING_SCHEDULED, PROPOSAL_APPROVED, CONTRACT_ACTIVATED, PROJECT_CREATED, PROJECT_COMPLETED, TASK_CREATED, TASK_COMPLETED, KNOWLEDGE_ARTICLE_PUBLISHED
  config      String?  // JSON string
  createdAt   DateTime @default(now())

  @@index([workflowId])
  @@index([type])
}

model WorkflowCondition {
  id          String   @id @default(uuid()) @map("_id")
  workflowId  String
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  field       String   // e.g. status, value, priority, title
  operator    String   // EQUALS, NOT_EQUALS, CONTAINS, GREATER_THAN, LESS_THAN, IS_SET
  value       String
  stepOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([workflowId])
}

model WorkflowAction {
  id          String   @id @default(uuid()) @map("_id")
  workflowId  String
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  type        String   // CREATE_RECORD, UPDATE_RECORD, ASSIGN_USER, SEND_NOTIFICATION, CREATE_ACTIVITY, CREATE_TASK, CREATE_PROJECT, EMAIL_ACTION, DELAY_ACTION
  config      String   // JSON string configuration
  stepOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([workflowId])
}

model WorkflowExecution {
  id             String       @id @default(uuid()) @map("_id")
  workflowId     String
  workflow       Workflow     @relation(fields: [workflowId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  triggerType    String
  entityType     String
  entityId       String
  status         String       @default("SUCCESS") // SUCCESS, FAILED, SKIPPED, IN_PROGRESS
  logs           String       // JSON string of step logs
  error          String?
  executedById   String?
  executedBy     User?        @relation(fields: [executedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt      DateTime     @default(now())

  @@index([workflowId])
  @@index([organizationId, createdAt])
}

model AIProvider {
  id             String       @id @default(uuid()) @map("_id")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  name           String       // e.g. "Production OpenAI", "Local Ollama"
  providerType   String       // OPENAI, ANTHROPIC, GEMINI, DEEPSEEK, OPENROUTER, OLLAMA
  apiKey         String?      // Encrypted API key
  baseUrl        String?      // Custom Base URL (e.g. http://localhost:11434 for Ollama)
  enabled        Boolean      @default(true)
  isDefault      Boolean      @default(false)
  
  createdBy      String
  creator        User         @relation("AIProviderCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedBy      String?
  updater        User?        @relation("AIProviderUpdatedBy", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  isDeleted      Boolean      @default(false)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  models         AIModel[]

  @@index([organizationId, enabled])
  @@index([organizationId, isDeleted])
}

model AIModel {
  id            String     @id @default(uuid()) @map("_id")
  providerId    String
  provider      AIProvider @relation(fields: [providerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  modelName     String     // e.g. "gpt-4o", "claude-3-5-sonnet", "gemini-1.5-pro", "deepseek-chat", "llama3"
  displayName   String
  maxTokens     Int        @default(4096)
  temperature   Float      @default(0.7)
  contextWindow Int        @default(128000)
  enabled       Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([providerId])
}

model PromptCategory {
  id             String           @id @default(uuid()) @map("_id")
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name           String
  description    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  templates      PromptTemplate[]

  @@index([organizationId])
}

model PromptTemplate {
  id                 String           @id @default(uuid()) @map("_id")
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categoryId         String?
  category           PromptCategory?  @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  name               String
  description        String?
  systemPrompt       String?
  userPrompt         String
  currentVersion     Int              @default(1)
  status             String           @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  tags               String           @default("[]")    // JSON string array e.g. ["sales", "lead"]
  modelCompatibility String           @default("[]")    // JSON string array e.g. ["gpt-4o", "claude-3-5-sonnet"]
  temperature        Float            @default(0.7)
  maxTokens          Int              @default(4096)

  createdBy          String
  creator            User             @relation("PromptCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedBy          String?
  updater            User?            @relation("PromptUpdatedBy", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  isDeleted          Boolean          @default(false)
  deletedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  versions           PromptVersion[]
  variables          PromptVariable[]
  logs               PromptExecutionLog[]
  agentPrompts       AIAgentPrompt[]

  @@index([organizationId, status])
  @@index([organizationId, isDeleted])
}

model PromptVersion {
  id             String         @id @default(uuid()) @map("_id")
  templateId     String
  template       PromptTemplate @relation(fields: [templateId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  versionNumber  Int
  systemPrompt   String?
  userPrompt     String
  variablesJson  String         @default("[]") // JSON snapshot of variables
  temperature    Float          @default(0.7)
  maxTokens      Int            @default(4096)
  changeSummary  String?

  createdBy      String
  creator        User           @relation("PromptVersionCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt      DateTime       @default(now())

  @@index([templateId, versionNumber])
}

model PromptVariable {
  id           String         @id @default(uuid()) @map("_id")
  templateId   String
  template     PromptTemplate @relation(fields: [templateId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  name         String         // e.g. company_name, client_name
  description  String?
  required     Boolean        @default(true)
  defaultValue String?
  type         String         @default("STRING") // STRING, NUMBER, BOOLEAN, JSON, CONTEXT

  @@index([templateId])
}

model PromptExecutionLog {
  id              String         @id @default(uuid()) @map("_id")
  templateId      String
  template        PromptTemplate @relation(fields: [templateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  executedById    String
  executedBy      User           @relation(fields: [executedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  variablesUsed   String         // JSON string
  status          String         @default("SUCCESS") // SUCCESS, FAILED
  executionTimeMs Int            @default(0)
  createdAt       DateTime       @default(now())

  @@index([templateId])
  @@index([organizationId, createdAt])
}

model AIConversationFolder {
  id             String           @id @default(uuid()) @map("_id")
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name           String
  color          String?          @default("bg-blue-500")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  conversations  AIConversation[]

  @@index([organizationId, userId])
}

model AIConversation {
  id             String                @id @default(uuid()) @map("_id")
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId         String
  user           User                  @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  folderId       String?
  folder         AIConversationFolder? @relation(fields: [folderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  title          String                @default("New AI Chat Thread")
  provider       String                @default("OPENAI")
  model          String                @default("gpt-4o")
  systemPrompt   String?
  isPinned       Boolean               @default(false)
  isArchived     Boolean               @default(false)
  isDeleted      Boolean               @default(false)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  messages       AIMessage[]
  shares         AIConversationShare[]
  pins           AIConversationPin[]

  @@index([organizationId, userId])
  @@index([organizationId, isPinned])
  @@index([organizationId, isArchived])
}

model AIMessage {
  id             String         @id @default(uuid()) @map("_id")
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  role           String         // SYSTEM, USER, ASSISTANT, TOOL
  content        String
  tokens         Int            @default(0)
  responseTimeMs Int            @default(0)
  provider       String?
  model          String?
  status         String         @default("DELIVERED") // SENT, DELIVERED, GENERATING, ERROR
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

model AIConversationShare {
  id               String         @id @default(uuid()) @map("_id")
  conversationId   String
  conversation     AIConversation @relation(fields: [conversationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sharedWithUserId String
  sharedWithUser   User           @relation(fields: [sharedWithUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  permission       String         @default("VIEW") // VIEW, EDIT
  createdAt        DateTime       @default(now())

  @@index([conversationId])
}

model AIConversationPin {
  id             String         @id @default(uuid()) @map("_id")
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt      DateTime       @default(now())

  @@index([conversationId, userId])
}

model AIMemoryCategory {
  id             String       @id @default(uuid()) @map("_id")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  memories       AIMemory[]

  @@index([organizationId])
}

model AIMemory {
  id             String            @id @default(uuid()) @map("_id")
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workspaceId    String?
  workspace      Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId         String?
  user           User?             @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categoryId     String?
  category       AIMemoryCategory? @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  title          String
  memoryType     String            // USER, ORGANIZATION, WORKSPACE, CONVERSATION, CRM, PROJECT, KNOWLEDGE
  summary        String
  source         String            // CRM, PROJECT, KNOWLEDGE, DOCUMENT, MEETING, CONVERSATION, WORKFLOW
  tags           String            @default("[]") // JSON string array
  importance     Int               @default(5)    // 1 to 10
  lastUsedAt     DateTime?
  isPinned       Boolean           @default(false)
  isArchived     Boolean           @default(false)
  isDeleted      Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId, memoryType])
  @@index([organizationId, isDeleted])
}

model AIContext {
  id             String       @id @default(uuid()) @map("_id")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  entityType     String       // CRM_LEAD, PROJECT, WORKSPACE, USER
  entityId       String
  contextData    String       // JSON payload
  summary        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, entityType, entityId])
}

model AIConversationContext {
  id              String   @id @default(uuid()) @map("_id")
  conversationId  String
  contextSnapshot String   // JSON snapshot
  activeMemories  String   @default("[]") // JSON string
  createdAt       DateTime @default(now())

  @@index([conversationId])
}

model AIWorkspaceMemory {
  id             String       @id @default(uuid()) @map("_id")
  workspaceId    String
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  key            String
  value          String
  category       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([workspaceId, key])
}

model AIUserPreference {
  id              String       @id @default(uuid()) @map("_id")
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  preferenceKey   String
  preferenceValue String
  category        String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId, preferenceKey])
}

// ==========================================
// ENTERPRISE AI ASSISTANT CORE
// ==========================================

model AIAssistant {
  id              String       @id @default(uuid()) @map("_id")
  name            String       @default("BlackDesk AI Assistant")
  description     String?      @default("Central Enterprise AI Assistant orchestrating intelligence across all workspace modules.")
  avatar          String?
  systemPrompt    String?      @default("You are BlackDesk Assistant, an intelligent enterprise AI assistant designed to automate workflows, answer queries across CRM, Projects, Knowledge Base, and Documents, and guide users through enterprise operations.")
  defaultProvider String       @default("OPENAI") // OPENAI, ANTHROPIC, GOOGLE, LOCAL
  defaultModel    String       @default("gpt-4o")
  temperature     Float        @default(0.7)
  maxTokens       Int          @default(4096)
  enabled         Boolean      @default(true)

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy       String
  creator         User         @relation("AIAssistantCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedBy       String?
  updater         User?        @relation("AIAssistantUpdatedBy", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  isDeleted       Boolean      @default(false)
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  capabilities    AIAssistantCapability[]
  permissions     AIAssistantPermission[]
  sessions        AIAssistantSession[]
  executions      AIAssistantExecution[]

  @@index([organizationId])
  @@index([organizationId, enabled])
}

model AIAssistantCapability {
  id          String      @id @default(uuid()) @map("_id")
  assistantId String
  assistant   AIAssistant @relation(fields: [assistantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  capability  String      // CRM, PROJECTS, TASKS, KNOWLEDGE, DOCUMENTS, MEETINGS, CONTRACTS, PROPOSALS, WORKFLOW_ENGINE, GLOBAL_SEARCH, MEMORY, NOTIFICATIONS
  enabled     Boolean     @default(true)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([assistantId, capability])
  @@index([assistantId])
}

model AIAssistantPermission {
  id          String      @id @default(uuid()) @map("_id")
  assistantId String
  assistant   AIAssistant @relation(fields: [assistantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  permission  String      // READ, WRITE, EXECUTE_ACTIONS, ACCESS_FINANCIAL_DATA, ACCESS_SENSITIVE_INFO, ORGANIZATION_SCOPE, WORKSPACE_SCOPE
  granted     Boolean     @default(true)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([assistantId, permission])
  @@index([assistantId])
}

model AIAssistantSession {
  id               String       @id @default(uuid()) @map("_id")
  assistantId      String
  assistant        AIAssistant  @relation(fields: [assistantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  title            String       @default("AI Assistant Conversation")
  currentContext   String?      // JSON string representation of current workspace/module context
  selectedProvider String?      @default("OPENAI")
  selectedModel    String?      @default("gpt-4o")
  promptUsed       String?
  status           String       @default("ACTIVE") // ACTIVE, COMPLETED, FAILED, PAUSED

  startedAt        DateTime     @default(now())
  endedAt          DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  executions       AIAssistantExecution[]

  @@index([assistantId])
  @@index([organizationId, userId])
  @@index([status])
}

model AIAssistantExecution {
  id                 String              @id @default(uuid()) @map("_id")
  assistantId        String
  assistant          AIAssistant         @relation(fields: [assistantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sessionId          String?
  session            AIAssistantSession? @relation(fields: [sessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  userPrompt         String
  assistantResponse  String
  tokens             Int                 @default(0)
  latencyMs          Int                 @default(0)
  provider           String
  model              String
  memoryUsed         String?             // JSON string array of memory keys/titles used
  promptTemplateUsed String?
  toolsRequested     String?             // JSON string array of tools requested/simulated
  executionStatus    String              @default("SUCCESS") // SUCCESS, FAILED, TIMED_OUT, INTERRUPTED

  createdAt          DateTime            @default(now())

  @@index([assistantId])
  @@index([sessionId])
  @@index([organizationId, userId])
  @@index([executionStatus])
}

// ==========================================
// ENTERPRISE TOOL CALLING FRAMEWORK
// ==========================================

model AIToolCategory {
  id          String   @id @default(uuid()) @map("_id")
  name        String   @unique // CRM, PROJECTS, KNOWLEDGE, DOCUMENTS, WORKFLOW, NOTIFICATIONS, SEARCH
  displayName String
  description String?
  icon        String?
  color       String?  @default("bg-blue-500")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tools       AITool[]
}

model AITool {
  id              String   @id @default(uuid()) @map("_id")
  key             String // e.g. crm_create_company, projects_create_task
  name            String
  description     String

  categoryId      String
  category        AIToolCategory @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  jsonSchema      String   // JSON schema payload string
  requiredParams  String   @default("[]") // JSON string array of required parameter names
  optionalParams  String   @default("[]") // JSON string array of optional parameter names
  validationRules String   @default("{}") // JSON validation constraints

  enabled         Boolean  @default(true)
  riskLevel       String   @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  parameters      AIToolParameter[]
  permissions     AIToolPermission[]
  executions      AIToolExecution[]
  agentAccesses   AIAgentToolAccess[]

  @@index([categoryId])
  @@index([key])
  @@index([enabled])
}

model AIToolParameter {
  id              String   @id @default(uuid()) @map("_id")
  toolId          String
  tool            AITool   @relation(fields: [toolId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  name            String   // Field name e.g. companyName, title, email
  type            String   // STRING, NUMBER, BOOLEAN, OBJECT, ARRAY
  description     String?
  required        Boolean  @default(false)
  defaultValue    String?
  validationRegex String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([toolId, name])
  @@index([toolId])
}

model AIToolPermission {
  id               String   @id @default(uuid()) @map("_id")
  toolId           String
  tool             AITool   @relation(fields: [toolId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  role             String   // SUPER_ADMIN, ADMIN, MANAGER, EMPLOYEE, CLIENT
  allowed          Boolean  @default(true)
  requiresApproval Boolean  @default(false)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([toolId, role])
  @@index([toolId])
}

model AIToolExecution {
  id             String       @id @default(uuid()) @map("_id")
  toolId         String
  tool           AITool       @relation(fields: [toolId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workspaceId    String?
  workspace      Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assistantId    String?

  inputParams    String       // JSON string input parameters
  outputResult   String       // JSON string mock structured output response
  status         String       @default("SUCCESS") // SUCCESS, FAILED, PERMISSION_DENIED, VALIDATION_ERROR
  errorMessage   String?
  latencyMs      Int          @default(0)
  isMock         Boolean      @default(true)

  createdAt      DateTime     @default(now())

  @@index([toolId])
  @@index([organizationId, userId])
  @@index([status])
}

// ==========================================
// ENTERPRISE RAG (RETRIEVAL-AUGMENTED GENERATION) ENGINE
// ==========================================

model RAGIndex {
  id                String       @id @default(uuid()) @map("_id")
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  name              String       @default("Enterprise Workspace RAG Index")
  description       String?
  chunkStrategy     String       @default("PARAGRAPH") // DOCUMENT, MARKDOWN, PARAGRAPH, SENTENCE
  chunkSize         Int          @default(512)
  chunkOverlap       Int          @default(64)
  embeddingProvider String       @default("OPENAI") // OPENAI, GEMINI, CLAUDE, OLLAMA, OPENROUTER
  embeddingModel    String       @default("text-embedding-3-small")
  dimensions        Int          @default(1536)

  status            String       @default("READY") // READY, INDEXING, FAILED
  totalDocuments    Int          @default(0)
  totalChunks       Int          @default(0)
  lastIndexedAt     DateTime?

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  documents         RAGDocument[]
  searches          RAGSearch[]
  agentKnowledgeScopes AIAgentKnowledgeScope[]

  @@index([organizationId])
}

model RAGDocument {
  id             String       @id @default(uuid()) @map("_id")
  indexId        String
  index          RAGIndex     @relation(fields: [indexId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  sourceType     String       // CRM_COMPANY, CRM_CONTACT, CRM_LEAD, CRM_OPPORTUNITY, CRM_MEETING, CRM_CONTRACT, PROJECT, TASK, KNOWLEDGE, DOCUMENT, WORKFLOW_LOG, ACTIVITY_LOG, NOTIFICATION
  sourceId       String
  title          String
  content        String
  metadataJson   String       @default("{}") // JSON string metadata
  checksum       String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  chunks         RAGChunk[]

  @@index([indexId])
  @@index([organizationId, sourceType])
  @@index([sourceId])
}

model RAGChunk {
  id            String       @id @default(uuid()) @map("_id")
  documentId    String
  document      RAGDocument  @relation(fields: [documentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  chunkIndex    Int
  content       String
  tokenCount    Int          @default(0)
  metadataJson  String       @default("{}")

  createdAt     DateTime     @default(now())

  embedding     RAGEmbedding?
  searchResults RAGSearchResult[]

  @@index([documentId])
  @@index([chunkIndex])
}

model RAGEmbedding {
  id                 String   @id @default(uuid()) @map("_id")
  chunkId            String   @unique
  chunk              RAGChunk @relation(fields: [chunkId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  provider           String   @default("OPENAI")
  model              String   @default("text-embedding-3-small")
  dimensions         Int      @default(1536)
  vectorPlaceholder  String   // JSON string array of 1536 float values

  createdAt          DateTime @default(now())
}

model RAGSearch {
  id             String       @id @default(uuid()) @map("_id")
  indexId        String
  index          RAGIndex     @relation(fields: [indexId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  query          String
  searchType     String       @default("HYBRID") // KEYWORD, SEMANTIC, HYBRID
  sourceFilters  String       @default("[]") // JSON string array of sources
  topK           Int          @default(5)
  executionTimeMs Int         @default(0)

  createdAt      DateTime     @default(now())

  results        RAGSearchResult[]

  @@index([indexId])
  @@index([organizationId, userId])
}

model RAGSearchResult {
  id             String    @id @default(uuid()) @map("_id")
  searchId       String
  search         RAGSearch @relation(fields: [searchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  chunkId        String
  chunk          RAGChunk  @relation(fields: [chunkId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  relevanceScore Float
  rank           Int

  createdAt      DateTime  @default(now())

  @@index([searchId])
}

// ==========================================
// ENTERPRISE MULTI-AGENT ORCHESTRATOR
// ==========================================

model AgentWorkflow {
  id              String       @id @default(uuid()) @map("_id")
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workspaceId     String?
  workspace       Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  title           String
  description     String?
  userPrompt      String
  finalResponse   String?
  status          String       @default("PENDING") // PENDING, PLANNING, EXECUTING, COMPLETED, FAILED, CANCELLED
  executionPlan   String?      // JSON: planned sequence of agents
  errorMessage    String?

  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  steps           AgentWorkflowStep[]
  delegations     AgentDelegation[]
  conversations   AgentConversation[]
  executionGraph  AgentExecutionGraph?
  sharedContexts  AgentSharedContext[]

  @@index([organizationId])
  @@index([organizationId, userId])
  @@index([status])
}

model AgentWorkflowStep {
  id              String        @id @default(uuid()) @map("_id")
  workflowId      String
  workflow        AgentWorkflow @relation(fields: [workflowId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  stepOrder       Int
  agentKey        String        // sales_agent, project_manager_agent, etc.
  agentName       String
  task            String
  inputData       String?       // JSON
  outputData      String?       // JSON
  status          String        @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED, SKIPPED
  startedAt       DateTime?
  completedAt     DateTime?
  errorMessage    String?
  latencyMs       Int           @default(0)

  createdAt       DateTime      @default(now())

  @@index([workflowId])
  @@index([workflowId, stepOrder])
}

model AgentDelegation {
  id                String         @id @default(uuid()) @map("_id")
  workflowId        String
  workflow          AgentWorkflow  @relation(fields: [workflowId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parentDelegationId String?
  parentDelegation  AgentDelegation? @relation("AgentDelegationParent", fields: [parentDelegationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  fromAgentKey      String
  fromAgentName     String
  toAgentKey        String
  toAgentName       String
  taskDescription   String
  contextData       String?       // JSON: shared context payload
  responseData      String?       // JSON: delegation result
  status            String        @default("PENDING") // PENDING, ACCEPTED, COMPLETED, FAILED, REJECTED
  priority          Int           @default(0)

  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime      @default(now())

  childDelegations  AgentDelegation[] @relation("AgentDelegationParent")

  @@index([workflowId])
  @@index([fromAgentKey])
  @@index([toAgentKey])
  @@index([status])
}

model AgentConversation {
  id              String        @id @default(uuid()) @map("_id")
  workflowId      String
  workflow        AgentWorkflow @relation(fields: [workflowId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  fromAgent       String
  fromAgentName   String
  toAgent         String
  toAgentName     String
  message         String
  messageType     String        @default("TEXT") // TEXT, QUERY, RESPONSE, RESULT, ERROR, COORDINATION
  metadataJson    String?       @default("{}")

  createdAt       DateTime      @default(now())

  @@index([workflowId])
  @@index([workflowId, createdAt])
}

model AgentExecutionGraph {
  id              String        @id @default(uuid()) @map("_id")
  workflowId      String        @unique
  workflow        AgentWorkflow @relation(fields: [workflowId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  graphData       String        // JSON: nodes & edges representation
  totalSteps      Int           @default(0)
  completedSteps  Int           @default(0)
  failedSteps     Int           @default(0)
  totalLatencyMs  Int           @default(0)
  status          String        @default("PENDING")

  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model AgentSharedContext {
  id              String        @id @default(uuid()) @map("_id")
  workflowId      String
  workflow        AgentWorkflow @relation(fields: [workflowId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  contextKey      String        // crm_data, projects, knowledge, meetings, contracts, tasks, memory, rag_context, prompt_templates
  contextType     String        // CRM, PROJECT, KNOWLEDGE, MEETING, CONTRACT, TASK, MEMORY, RAG, PROMPT
  data            String        // JSON payload
  sourceAgentKey  String?
  version         Int           @default(1)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([workflowId, contextKey])
  @@index([workflowId])
}
// ==========================================
// ENTERPRISE SPECIALIZED AI AGENTS FRAMEWORK
// ==========================================

model AIAgent {
  id              String       @id @default(uuid()) @map("_id")
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  key             String       // sales_agent, project_manager_agent, knowledge_assistant, meeting_assistant, finance_assistant, ceo_executive_assistant, or custom_key
  name            String
  role            String       // e.g. "Sales Intelligence & Lead Qualification Specialist"
  department      String       // Sales, Project Management, Knowledge, Meetings, Finance, Executive, Custom
  description     String?
  avatar          String?
  systemPrompt    String?

  defaultProvider String       @default("OPENAI") // OPENAI, ANTHROPIC, GOOGLE, LOCAL
  defaultModel    String       @default("gpt-4o")
